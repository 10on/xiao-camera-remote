	(text "SPI DISPLAY MODULE\nJ4: VCC, GND, DIN, CLK, CS, DC, RST, BL\nCS is permanently tied to GND. RST is intentionally not connected;\nuse only when the display module has an onboard RST pull-up."
		(exclude_from_sim no)
		(at 170 30 0.0000)
		(effects
			(font
				(size 1 1)
			)
		)
		(uuid "979bde03-02ca-4ac5-9daf-233d38b3b47f")
	)
	(text "STATUS LED\nSingle WS2812B pixel"
		(exclude_from_sim no)
		(at 180 92 0.0000)
		(effects
