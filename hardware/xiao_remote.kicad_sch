	)
	(text "PASSIVE PIEZO\nDriven directly by D7 / GPIO44"
		(exclude_from_sim no)
		(at 180 120 0.0000)
		(effects
			(font
				(size 1 1)
			)
		)
		(uuid "83782994-90b2-44f3-a011-06c677915156")
	)
	(text "Li-Po 1S2P BATTERY + VOLTAGE SENSE\nTwo parallel cells: 3.0–4.2 V nominal pack range.\nR1=R2=100k gives divider ratio 2.0 to D2 / GPIO3.\nBattery power connects to XIAO BAT pads; onboard charger handles USB-C charging."
		(exclude_from_sim no)
		(at 38 137 0.0000)
		(effects
			(font
				(size 1 1)
			)
		)
		(uuid "5e610636-963e-4a53-9e55-3f29edb94b95")
	)
	(text "IMPORTANT: +3V3 powers TFT VCC/BL and WS2812. +5V_USB is shown but unused.\nAll GND labels are one common net. Verify the actual display module pin order before soldering."
		(exclude_from_sim no)
		(at 80 180 0.0000)
		(effects
			(font
				(size 1 1)
			)
		)
